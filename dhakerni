def ensure_config_dir():
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)


def load_config():
    ensure_config_dir()
    if CONFIG_FILE.exists():
        return json.loads(CONFIG_FILE.read_text(encoding="utf-8"))
    return {}


def save_config(config):
    ensure_config_dir()
    CONFIG_FILE.write_text(
        json.dumps(config, ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8",
    )


def load_custom_adhkar():
    ensure_config_dir()
    if ADHKAR_FILE.exists():
        return json.loads(ADHKAR_FILE.read_text(encoding="utf-8"))
    return []


def save_custom_adhkar(adhkar):
    ensure_config_dir()
    ADHKAR_FILE.write_text(
        json.dumps(adhkar, ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8",
    )


def get_all_adhkar(category=None):
    result = []
    categories = [category] if category else CATEGORIES
    for cat in categories:
        for text in BUILT_IN_ADHKAR.get(cat, []):
            result.append({"text": text, "category": cat, "built_in": True})
    for entry in load_custom_adhkar():
        if category and entry.get("category") != category:
            continue
        result.append({**entry, "built_in": False})
    return result


def parse_duration(s):
    s = s.strip().lower()
    if s.endswith("s"):
        return int(s[:-1])
    if s.endswith("m"):
        return int(s[:-1]) * 60
    if s.endswith("h"):
        return int(s[:-1]) * 3600
    try:
        return int(s)
    except ValueError:
        return None


def format_duration(seconds):
    if seconds >= 3600:
        h = seconds // 3600
        m = (seconds % 3600) // 60
        return f"{h}h{m}m" if m else f"{h}h"
    if seconds >= 60:
        m = seconds // 60
        s = seconds % 60
        return f"{m}m{s}s" if s else f"{m}m"
    return f"{seconds}s"


def notify(message, duration_sec=10):
    if not shutil.which("notify-send"):
        print("Error: notify-send is not installed.", file=sys.stderr)
        print("On Ubuntu/Debian: sudo apt install libnotify-bin", file=sys.stderr)
        sys.exit(1)
    subprocess.run(
        [
            "notify-send",
            "--app-name=dhakerni",
            "--urgency=normal",
            f"--expire-time={duration_sec * 1000}",
            "--icon=dialog-information",
            "ذِكر",
            message,
        ],
        check=True,
    )


# ── CLI commands ──────────────────────────────────────────────────────────────


def cmd_run(args):
    config = load_config()
    interval = parse_duration(args.interval) if args.interval else None
    duration = parse_duration(args.duration or config.get("duration", "10s"))
    if duration is None:
        print(f"Invalid duration: {args.duration}", file=sys.stderr)
        sys.exit(1)

    category = args.category or config.get("default_category")
    adhkar = get_all_adhkar(category)
    if not adhkar:
        print(f"No adhkar found for category '{category}'.", file=sys.stderr)
        sys.exit(1)

    chosen = random.choice(adhkar)
    notify(chosen["text"], duration)


def cmd_install(args):
    if not shutil.which("systemctl"):
        print("Error: systemctl is not available.", file=sys.stderr)
        sys.exit(1)

    config = load_config()

    if args.interval:
        parsed = parse_duration(args.interval)
        if parsed is None:
            print(f"Invalid interval: {args.interval}", file=sys.stderr)
            sys.exit(1)
        config["interval"] = args.interval
    if args.duration:
        parsed = parse_duration(args.duration)
        if parsed is None:
            print(f"Invalid duration: {args.duration}", file=sys.stderr)
            sys.exit(1)
        config["duration"] = args.duration

    save_config(config)

    interval_str = config.get("interval", "5m")
    interval_sec = parse_duration(interval_str)
    interval_human = format_duration(interval_sec)

    script_path = Path(__file__).resolve()

    SYSTEMD_DIR.mkdir(parents=True, exist_ok=True)

    SERVICE_FILE.write_text(
        textwrap.dedent(f"""\
            [Unit]
            Description=Dhikr reminder notification

            [Service]
            Type=oneshot
            ExecStart={script_path} run
        """),
        encoding="utf-8",
    )

    TIMER_FILE.write_text(
        textwrap.dedent(f"""\
            [Unit]
            Description=Dhikr reminder every {interval_human}

            [Timer]
            OnBootSec=30s
            OnUnitActiveSec={interval_sec}s
            AccuracySec=30s
            Unit=dhakerni.service

            [Install]
            WantedBy=timers.target
        """),
        encoding="utf-8",
    )

    subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
    subprocess.run(["systemctl", "--user", "enable", "dhakerni.timer"], check=True)
    subprocess.run(["systemctl", "--user", "start", "dhakerni.timer"], check=True)

    print(f"✅ dhakerni installed successfully.")
    print(f"   Interval: every {interval_human}")
    print(f"   Notification duration: {config.get('duration', '10s')}")
    print()
    print("Commands:")
    print("  Run now:       dhakerni run")
    print("  Check status:  dhakerni status")
    print("  Uninstall:     dhakerni uninstall")


def cmd_uninstall(args):
    if not shutil.which("systemctl"):
        print("Error: systemctl is not available.", file=sys.stderr)
        sys.exit(1)

    subprocess.run(["systemctl", "--user", "stop", "dhakerni.timer"], check=False)
    subprocess.run(
        ["systemctl", "--user", "disable", "dhakerni.timer"], check=False
    )

    SERVICE_FILE.unlink(missing_ok=True)
    TIMER_FILE.unlink(missing_ok=True)

    subprocess.run(["systemctl", "--user", "daemon-reload"], check=False)

    print("✅ dhakerni uninstalled.")
    print("   Timer stopped and removed.")
    print("   Config files kept at ~/.config/dhakerni/")
    print("   To remove config: rm -rf ~/.config/dhakerni")


def cmd_add(args):
    text = " ".join(args.text)
    if not text.strip():
        print("Error: dhikr text cannot be empty.", file=sys.stderr)
        sys.exit(1)

    category = args.category or "general"
    if category not in CATEGORIES:
        print(
            f"Error: unknown category '{category}'. "
            f"Valid categories: {', '.join(CATEGORIES)}",
            file=sys.stderr,
        )
        sys.exit(1)

    custom = load_custom_adhkar()
    next_id = 1
    if custom:
        next_id = max(e.get("id", 0) for e in custom) + 1

    entry = {"id": next_id, "text": text, "category": category}
    custom.append(entry)
    save_custom_adhkar(custom)

    print(f"✅ Added dhikr #{next_id} to '{category}':")
    print(f"   {text}")


def cmd_remove(args):
    custom = load_custom_adhkar()
    target_id = args.id

    new_list = [e for e in custom if e.get("id") != target_id]
    if len(new_list) == len(custom):
        print(f"Error: no custom dhikr with ID #{target_id}.", file=sys.stderr)
        print("Use 'dhakerni list' to see available IDs.", file=sys.stderr)
        sys.exit(1)

    save_custom_adhkar(new_list)
    print(f"✅ Removed custom dhikr #{target_id}.")


def cmd_list(args):
    config = load_config()
    category = args.category or config.get("default_category")
    adhkar = get_all_adhkar(category)

    if not adhkar:
        print("No adhkar found.")
        return

    current_cat = None
    for entry in adhkar:
        cat = entry["category"]
        if cat != current_cat:
            current_cat = cat
            label = CATEGORY_LABELS.get(cat, cat)
            print(f"\n── {label} ({cat}) ──")
        tag = "" if entry["built_in"] else " [custom]"
        print(f"  {entry['text']}{tag}")

    custom = load_custom_adhkar()
    built_in_count = sum(
        len(v) for v in BUILT_IN_ADHKAR.values()
    )
    print(f"\n{built_in_count} built-in, {len(custom)} custom")


def cmd_status(args):
    if not shutil.which("systemctl"):
        print("Error: systemctl is not available.", file=sys.stderr)
        sys.exit(1)

    result = subprocess.run(
        ["systemctl", "--user", "is-active", "dhakerni.timer"],
        capture_output=True,
        text=True,
    )
    is_active = result.stdout.strip() == "active"

    if is_active:
        print("✅ dhakerni timer is active")
        subprocess.run(
            ["systemctl", "--user", "status", "dhakerni.timer", "--no-pager"],
            check=False,
        )
    else:
        print("⏸️  dhakerni timer is not active")
        print("   Install with: dhakerni install")


def cmd_config(args):
    config = load_config()

    if args.set_interval:
        parsed = parse_duration(args.set_interval)
        if parsed is None:
            print(f"Invalid interval: {args.set_interval}", file=sys.stderr)
            sys.exit(1)
        config["interval"] = args.set_interval
        save_config(config)
        print(f"✅ Default interval set to {args.set_interval}")

    if args.set_duration:
        parsed = parse_duration(args.set_duration)
        if parsed is None:
            print(f"Invalid duration: {args.set_duration}", file=sys.stderr)
            sys.exit(1)
        config["duration"] = args.set_duration
        save_config(config)
        print(f"✅ Default notification duration set to {args.set_duration}")

    if args.set_category:
        cat = args.set_category
        if cat not in CATEGORIES:
            print(
                f"Error: unknown category '{cat}'. "
                f"Valid categories: {', '.join(CATEGORIES)}",
                file=sys.stderr,
            )
            sys.exit(1)
        config["default_category"] = cat
        save_config(config)
        print(f"✅ Default category set to '{cat}'")

    if not any([args.set_interval, args.set_duration, args.set_category]):
        if not config:
            print("No config found. Using defaults:")
        else:
            print("Current config:")
        print(f"  Interval:    {config.get('interval', '5m')}")
        print(f"  Duration:    {config.get('duration', '10s')}")
        print(f"  Category:    {config.get('default_category', 'all')}")
        print()
        print("Update with:")
        print("  dhakerni config --set-interval 10m")
        print("  dhakerni config --set-duration 20s")
        print("  dhakerni config --set-category morning")


# ── Argument parser ───────────────────────────────────────────────────────────


def build_parser():
    parser = argparse.ArgumentParser(
        prog="dhakerni",
        description="ذِكر — A dhikr reminder for your desktop",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=textwrap.dedent("""\
            categories:
              morning   أذكار الصباح      evening  أذكار المساء
              sleep     أذكار النوم        wake     أذكار الاستيقاظ
              prayer    أذكار الصلاة       general  أذكار عامة

            examples:
              dhakerni run                        random dhikr notification
              dhakerni run -c morning             random morning dhikr
              dhakerni install -i 15m             install timer every 15 min
              dhakerni add "دعاء" -c prayer       add custom dhikr
              dhakerni list -c evening            list evening adhkar
              dhakerni config --set-interval 10m  change default interval
        """),
    )
    parser.add_argument("-V", "--version", action="version", version=f"%(prog)s {VERSION}")

    sub = parser.add_subparsers(dest="command")

    # run
    p_run = sub.add_parser("run", help="Show a random dhikr notification")
    p_run.add_argument("-c", "--category", choices=CATEGORIES, help="Filter by category")
    p_run.add_argument("-i", "--interval", help="Override interval (not used for one-shot)")
    p_run.add_argument("-d", "--duration", help="Notification expiry time (e.g. 10s, 30s)")
    p_run.set_defaults(func=cmd_run)

    # install
    p_install = sub.add_parser("install", help="Install systemd timer")
    p_install.add_argument("-i", "--interval", help="Time between reminders (e.g. 5m, 1h)")
    p_install.add_argument("-d", "--duration", help="Notification expiry time (e.g. 10s)")
    p_install.set_defaults(func=cmd_install)

    # uninstall
    p_uninstall = sub.add_parser("uninstall", help="Remove systemd timer")
    p_uninstall.set_defaults(func=cmd_uninstall)

    # add
    p_add = sub.add_parser("add", help="Add a custom dhikr")
    p_add.add_argument("text", nargs="+", help="Dhikr text")
    p_add.add_argument("-c", "--category", choices=CATEGORIES, help="Assign category")
    p_add.set_defaults(func=cmd_add)

    # remove
    p_remove = sub.add_parser("remove", help="Remove a custom dhikr by ID")
    p_remove.add_argument("id", type=int, help="Dhikr ID (see 'dhakerni list')")
    p_remove.set_defaults(func=cmd_remove)

    # list
    p_list = sub.add_parser("list", help="List all adhkar")
    p_list.add_argument("-c", "--category", choices=CATEGORIES, help="Filter by category")
    p_list.set_defaults(func=cmd_list)

    # status
    p_status = sub.add_parser("status", help="Show timer status")
    p_status.set_defaults(func=cmd_status)

    # config
    p_config = sub.add_parser("config", help="View or update settings")
    p_config.add_argument("--set-interval", metavar="TIME", help="Set default interval")
    p_config.add_argument("--set-duration", metavar="TIME", help="Set default notification duration")
    p_config.add_argument(
        "--set-category",
        metavar="CAT",
        choices=CATEGORIES,
        help="Set default category",
    )
    p_config.set_defaults(func=cmd_config)

    return parser


def main():
    parser = build_parser()
    args = parser.parse_args()

    if not args.command:
        parser.print_help()
        sys.exit(0)

    args.func(args)


if __name__ == "__main__":
    main()
