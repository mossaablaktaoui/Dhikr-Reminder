def fail(message):
    print(f"Error: {message}", file=sys.stderr)
    raise SystemExit(1)


def ensure_config_dir():
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)


def read_json(path, default):
    if not path.exists():
        return default
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        fail(f"could not read {path}: {exc}")


def write_json(path, value):
    ensure_config_dir()
    path.write_text(
        json.dumps(value, ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8",
    )


def load_config():
    raw = read_json(CONFIG_FILE, {})
    config = DEFAULT_CONFIG.copy()
    if isinstance(raw, dict):
        for key in DEFAULT_CONFIG:
            if key in raw:
                config[key] = raw[key]
    return config


def save_config(config):
    write_json(CONFIG_FILE, {key: config[key] for key in DEFAULT_CONFIG})


def load_custom_adhkar():
    entries = read_json(ADHKAR_FILE, [])
    if not isinstance(entries, list):
        fail(f"{ADHKAR_FILE} must contain a JSON list")

    # Compatibility with old sleep/wake/prayer custom entries.
    changed = False
    for entry in entries:
        if isinstance(entry, dict) and entry.get("category") not in CATEGORIES:
            entry["category"] = "general"
            changed = True
    if changed:
        write_json(ADHKAR_FILE, entries)
    return entries


def load_state():
    state = read_json(STATE_FILE, {})
    return state if isinstance(state, dict) else {}


def save_state(state):
    write_json(STATE_FILE, state)


def parse_duration(value):
    if not isinstance(value, str):
        return None
    match = re.fullmatch(r"\s*(\d+)\s*([smh]?)\s*", value.lower())
    if not match:
        return None
    amount = int(match.group(1))
    if amount <= 0:
        return None
    multiplier = {"": 1, "s": 1, "m": 60, "h": 3600}[match.group(2)]
    return amount * multiplier


def format_duration(seconds):
    if seconds % 3600 == 0:
        return f"{seconds // 3600}h"
    if seconds % 60 == 0:
        return f"{seconds // 60}m"
    return f"{seconds}s"


def parse_clock(value):
    try:
        parsed = datetime.strptime(value, "%H:%M")
    except (TypeError, ValueError):
        return None
    return parsed.hour * 60 + parsed.minute


def validate_schedule(config):
    keys = ("morning_start", "general_start", "evening_start", "quiet_start")
    values = []
    for key in keys:
        minutes = parse_clock(config.get(key))
        if minutes is None:
            fail(f"invalid time for {key}: {config.get(key)!r}; use HH:MM")
        values.append(minutes)
    if values != sorted(values) or len(set(values)) != len(values):
        fail("time ranges must be ordered: morning < general < evening < quiet")


def current_period(config, now=None):
    validate_schedule(config)
    now = now or datetime.now().astimezone()
    minute = now.hour * 60 + now.minute

    morning = parse_clock(config["morning_start"])
    general = parse_clock(config["general_start"])
    evening = parse_clock(config["evening_start"])
    quiet = parse_clock(config["quiet_start"])

    if minute < morning or minute >= quiet:
        return "quiet"
    if minute < general:
        return "morning"
    if minute < evening:
        return "general"
    return "evening"


def get_all_adhkar(category):
    result = [
        {"text": text, "category": category, "built_in": True}
        for text in BUILT_IN_ADHKAR.get(category, [])
    ]
    for entry in load_custom_adhkar():
        if not isinstance(entry, dict) or entry.get("category") != category:
            continue
        text = str(entry.get("text", "")).strip()
        if text:
            result.append({**entry, "text": text, "built_in": False})
    return result


def choose_adhkar(category):
    adhkar = get_all_adhkar(category)
    if not adhkar:
        fail(f"no adhkar found for category '{category}'")

    last_text = load_state().get("last_text")
    choices = [entry for entry in adhkar if entry["text"] != last_text]
    if not choices:
        choices = adhkar

    chosen = random.choice(choices)
    save_state({"last_text": chosen["text"]})
    return chosen["text"]


def notify(message, duration_sec):
    notify_send = shutil.which("notify-send")
    if not notify_send:
        fail("notify-send is not installed")

    # A single positional string becomes the notification summary: no separate
    # title, body, explicit icon, or decorative image.
    subprocess.run(
        [
            notify_send,
            "--app-name=dhakerni",
            "--urgency=normal",
            f"--expire-time={duration_sec * 1000}",
            message,
        ],
        check=True,
    )


def systemctl(*args, check=True, capture_output=False):
    if not shutil.which("systemctl"):
        fail("systemctl is not available")
    return subprocess.run(
        ["systemctl", "--user", *args],
        check=check,
        capture_output=capture_output,
        text=True,
    )


def write_systemd_units(config):
    interval_sec = parse_duration(config["interval"])
    if interval_sec is None:
        fail(f"invalid interval: {config['interval']}")

    SYSTEMD_DIR.mkdir(parents=True, exist_ok=True)
    SERVICE_FILE.write_text(
        textwrap.dedent("""\
            [Unit]
            Description=Dhakerni dhikr reminder

            [Service]
            Type=oneshot
            ExecStart=%h/.local/bin/dhakerni run
        """),
        encoding="utf-8",
    )
    TIMER_FILE.write_text(
        textwrap.dedent(f"""\
            [Unit]
            Description=Dhakerni reminder every {format_duration(interval_sec)}

            [Timer]
            OnBootSec=30s
            OnUnitActiveSec={interval_sec}s
            AccuracySec=30s
            Unit=dhakerni.service

            [Install]
            WantedBy=timers.target
        """),
        encoding="utf-8",
    )


def timer_installed():
    return SERVICE_FILE.exists() and TIMER_FILE.exists()


def refresh_timer(config, restart=True):
    write_systemd_units(config)
    systemctl("daemon-reload")
    if restart:
        result = systemctl("is-active", "dhakerni.timer", check=False, capture_output=True)
        if result.stdout.strip() == "active":
            systemctl("restart", "dhakerni.timer")


# ── Commands ────────────────────────────────────────────────────────────────


def cmd_run(args):
    config = load_config()
    validate_schedule(config)

    duration_text = args.duration or config["duration"]
    duration = parse_duration(duration_text)
    if duration is None:
        fail(f"invalid duration: {duration_text}")

    category = args.category or current_period(config)
    if category == "quiet":
        if sys.stdout.isatty():
            print("Quiet hours: no notification shown.")
        return

    notify(choose_adhkar(category), duration)


def cmd_install(args):
    if not shutil.which("systemctl"):
        fail("systemctl is not available")
    if not shutil.which("notify-send"):
        fail("notify-send is not installed")

    config = load_config()
    if args.interval:
        if parse_duration(args.interval) is None:
            fail(f"invalid interval: {args.interval}")
        config["interval"] = args.interval
    if args.duration:
        if parse_duration(args.duration) is None:
            fail(f"invalid duration: {args.duration}")
        config["duration"] = args.duration
    save_config(config)

    BIN_DIR.mkdir(parents=True, exist_ok=True)
    source = Path(__file__).resolve()
    if source != INSTALL_PATH.resolve(strict=False):
        shutil.copy2(source, INSTALL_PATH)
    INSTALL_PATH.chmod(0o755)

    write_systemd_units(config)
    systemctl("daemon-reload")
    systemctl("enable", "--now", "dhakerni.timer")

    print(f"Installed: {INSTALL_PATH}")
    print(f"Interval: {config['interval']}")


def cmd_uninstall(args):
    if shutil.which("systemctl"):
        systemctl("disable", "--now", "dhakerni.timer", check=False)
        SERVICE_FILE.unlink(missing_ok=True)
        TIMER_FILE.unlink(missing_ok=True)
        systemctl("daemon-reload", check=False)
    else:
        SERVICE_FILE.unlink(missing_ok=True)
        TIMER_FILE.unlink(missing_ok=True)

    INSTALL_PATH.unlink(missing_ok=True)

    if args.purge:
        shutil.rmtree(CONFIG_DIR, ignore_errors=True)

    print("Uninstalled dhakerni." + (" Config removed." if args.purge else " Config kept."))


def cmd_add(args):
    text = " ".join(args.text).strip()
    if not text:
        fail("dhikr text cannot be empty")

    custom = load_custom_adhkar()
    next_id = max((int(e.get("id", 0)) for e in custom if isinstance(e, dict)), default=0) + 1
    custom.append({"id": next_id, "text": text, "category": args.category})
    write_json(ADHKAR_FILE, custom)
    print(f"Added #{next_id} to {args.category}.")


def cmd_remove(args):
    custom = load_custom_adhkar()
    new_list = [e for e in custom if not isinstance(e, dict) or e.get("id") != args.id]
    if len(new_list) == len(custom):
        fail(f"no custom dhikr with ID #{args.id}")
    write_json(ADHKAR_FILE, new_list)
    print(f"Removed #{args.id}.")


def cmd_list(args):
    categories = [args.category] if args.category else list(CATEGORIES)
    for category in categories:
        print(f"\n{CATEGORY_LABELS[category]} ({category})")
        for entry in get_all_adhkar(category):
            if entry["built_in"]:
                print(f"  {entry['text']}")
            else:
                print(f"  #{entry.get('id', '?')} [custom] {entry['text']}")


def cmd_status(args):
    config = load_config()
    period = current_period(config)
    local_now = datetime.now().astimezone()

    active = False
    if shutil.which("systemctl"):
        result = systemctl("is-active", "dhakerni.timer", check=False, capture_output=True)
        active = result.stdout.strip() == "active"

    print(f"Timer: {'active' if active else 'inactive'}")
    print(f"Installed: {'yes' if INSTALL_PATH.exists() and timer_installed() else 'no'}")
    print(f"Local time: {local_now.strftime('%H:%M %Z')}")
    print(f"Current period: {period}")
    print(f"Interval: {config['interval']}")

    if args.full and shutil.which("systemctl"):
        systemctl("status", "dhakerni.timer", "--no-pager", check=False)


def cmd_config(args):
    config = load_config()
    was_installed = timer_installed()
    changed = False
    interval_changed = False

    updates = {
        "interval": args.set_interval,
        "duration": args.set_duration,
        "morning_start": args.set_morning_start,
        "general_start": args.set_general_start,
        "evening_start": args.set_evening_start,
        "quiet_start": args.set_quiet_start,
    }

    if updates["interval"] is not None:
        if parse_duration(updates["interval"]) is None:
            fail(f"invalid interval: {updates['interval']}")
        interval_changed = updates["interval"] != config["interval"]
    if updates["duration"] is not None and parse_duration(updates["duration"]) is None:
        fail(f"invalid duration: {updates['duration']}")

    for key in ("morning_start", "general_start", "evening_start", "quiet_start"):
        if updates[key] is not None and parse_clock(updates[key]) is None:
            fail(f"invalid time: {updates[key]}; use HH:MM")

    for key, value in updates.items():
        if value is not None:
            config[key] = value
            changed = True

    if args.reset:
        config = DEFAULT_CONFIG.copy()
        changed = True
        interval_changed = True

    validate_schedule(config)

    if changed:
        save_config(config)
        if was_installed and interval_changed:
            refresh_timer(config, restart=True)
        print("Config updated.")

    if args.show or not changed:
        print(f"Interval:      {config['interval']}")
        print(f"Duration:      {config['duration']}")
        print(f"Morning:       {config['morning_start']} → {config['general_start']}")
        print(f"General:       {config['general_start']} → {config['evening_start']}")
        print(f"Evening:       {config['evening_start']} → {config['quiet_start']}")
        print(f"Quiet:         {config['quiet_start']} → {config['morning_start']}")


# ── Parser ──────────────────────────────────────────────────────────────────


def build_parser():
    parser = argparse.ArgumentParser(
        prog="dhakerni",
        description="A time-aware desktop dhikr reminder for Linux.",
        epilog="Use 'dhakerni COMMAND --help' for command-specific help.",
    )
    parser.add_argument("-V", "--version", action="version", version=f"%(prog)s {VERSION}")
    sub = parser.add_subparsers(dest="command", metavar="COMMAND")

    p = sub.add_parser("run", help="show one dhikr using the current local time")
    p.add_argument("-c", "--category", choices=CATEGORIES, help="override automatic time category")
    p.add_argument("-d", "--duration", metavar="TIME", help="override notification duration, e.g. 10s")
    p.set_defaults(func=cmd_run)

    p = sub.add_parser("install", help="install/update dhakerni and its user timer")
    p.add_argument("-i", "--interval", metavar="TIME", help="reminder interval, e.g. 5m, 1h")
    p.add_argument("-d", "--duration", metavar="TIME", help="notification duration, e.g. 10s")
    p.set_defaults(func=cmd_install)

    p = sub.add_parser("uninstall", help="remove dhakerni and its user timer")
    p.add_argument("--purge", action="store_true", help="also remove ~/.config/dhakerni")
    p.set_defaults(func=cmd_uninstall)

    p = sub.add_parser("add", help="add a custom dhikr")
    p.add_argument("text", nargs="+", help="dhikr text")
    p.add_argument("-c", "--category", choices=CATEGORIES, default="general", help="category (default: general)")
    p.set_defaults(func=cmd_add)

    p = sub.add_parser("remove", help="remove a custom dhikr by ID")
    p.add_argument("id", type=int, help="custom ID shown by 'dhakerni list'")
    p.set_defaults(func=cmd_remove)

    p = sub.add_parser("list", help="list built-in and custom adhkar")
    p.add_argument("-c", "--category", choices=CATEGORIES, help="show one category only")
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("status", help="show timer and current time-period status")
    p.add_argument("--full", action="store_true", help="also show full systemd timer status")
    p.set_defaults(func=cmd_status)

    p = sub.add_parser("config", help="view or update settings")
    p.add_argument("--show", action="store_true", help="show config after applying changes")
    p.add_argument("--reset", action="store_true", help="restore default settings")
    p.add_argument("--set-interval", metavar="TIME", help="set interval, e.g. 10m")
    p.add_argument("--set-duration", metavar="TIME", help="set notification duration, e.g. 10s")
    p.add_argument("--set-morning-start", metavar="HH:MM", help="start of morning period")
    p.add_argument("--set-general-start", metavar="HH:MM", help="start of general period")
    p.add_argument("--set-evening-start", metavar="HH:MM", help="start of evening period")
    p.add_argument("--set-quiet-start", metavar="HH:MM", help="start of quiet period")
    p.set_defaults(func=cmd_config)

    return parser


def main():
    parser = build_parser()
    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        return
    args.func(args)


if __name__ == "__main__":
    main()
